{
  "info": {
    "_postman_id": "projeto-docker-api",
    "name": "Projeto Docker API",
    "description": "Collection para testar API de Usuários",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/health",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["health"]
        },
        "description": "Verificar se a API está rodando"
      }
    },
    {
      "name": "Testar Conexão BD",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/db-test",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["db-test"]
        },
        "description": "Testar conexão com PostgreSQL"
      }
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Criar Usuário",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"joao@example.com\",\n  \"name\": \"João Silva\",\n  \"age\": 25\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/users",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "users"]
            },
            "description": "Criar novo usuário no banco de dados"
          }
        },
        {
          "name": "Listar Todos os Usuários",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/users",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "users"]
            },
            "description": "Obter lista completa de usuários"
          }
        },
        {
          "name": "Obter Usuário por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/users/{{user_id}}",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "users", "{{user_id}}"]
            },
            "description": "Obter usuário específico pelo ID (substitua {{user_id}} por um ID real)"
          }
        },
        {
          "name": "Atualizar Usuário",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"João Silva Atualizado\",\n  \"age\": 26\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/users/{{user_id}}",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "users", "{{user_id}}"]
            },
            "description": "Atualizar dados de um usuário (substitua {{user_id}})"
          }
        },
        {
          "name": "Deletar Usuário",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/users/{{user_id}}",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "users", "{{user_id}}"]
            },
            "description": "Deletar um usuário (substitua {{user_id}})"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "user_id",
      "value": "",
      "type": "string",
      "description": "ID do usuário - copie o ID retornado no POST"
    }
  ]
}
